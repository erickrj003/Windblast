{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"target": "es2025",
		"lib": ["es2025"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true
	},
	"include": ["*.js", "scripts/*.ts", "apps/web/vite.config.ts"]
}
