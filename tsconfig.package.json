{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"target": "es2025",
		"lib": ["es2025"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": [],

		"composite": true,
		"emitDeclarationOnly": true,
		"declarationMap": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true
	}
}
